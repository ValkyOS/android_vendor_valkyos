// Runtime overlay for framework-res. LineageOS overlays (vendor/lineage/overlay/common)
// become auto-generated RROs with priority 0/1, so this one (999) wins.
runtime_resource_overlay {
    name: "ValkyOSFrameworkOverlay",
    product_specific: true,
}
